use "bit -> tui" from "tui"

mod ui_state
mod ui_update
mod ui_view

;; ── Instalator HackerOS — Server Edition (TTY, tui) ──────────────────
;;
;; * Instalacja biegnie w TLE (installer_run::start → runner.sh); pętla
;;   `tui::run` dostaje co ~100 ms komunikat "tick" i odpytuje `poll()`,
;;   więc pasek postępu płynie na żywo i terminal nie zamarza.
;; * Pola haseł są maskowane (gwiazdki) — `textinput` z tui nie ma trybu
;;   hasła, więc maskujemy w widoku (mask_view); wartość trzymana jest zwykłym
;;   textinput.
;; * Uruchamiaj interpreterem (`bit run` / `h# preview`) — patrz README tui:
;;   odczyt pojedynczego klawisza nie ma wsparcia w kompilatorze natywnym.
;;
;; Podział na moduły (od dołu zależności ku górze):
;;   ui_state.h#        Stan kreatora (struktura Model, init) i stałe list wyboru.
;;   ui_cfg.h#          Budowanie InstallConfig z modelu oraz pomocnicze operacje na tablicach.
;;   ui_nav.h#          Nawigacja między krokami, ticki (Wi-Fi/instalacja) i routing fokusu pól.
;;   ui_update_forms.h# update: ekrany z polami (sieć, dysk, partycje, profil, konto).
;;   ui_update.h#       update: podsumowanie, zakończenie i główna funkcja update.
;;   ui_saved.h#        Wczytywanie zapisanej konfiguracji do modelu.
;;   ui_widgets.h#      Style i drobne elementy widoku (nagłówek, pola, maskowanie haseł).
;;   ui_view_form.h#    Widoki ekranów kreatora: powitanie, wybory, sieć, dysk, partycje, profil, konto.
;;   ui_view.h#         Widoki: podsumowanie, instalacja, koniec; główna funkcja view i ramka na cały terminal.

;; ── punkt wejścia ────────────────────────────────────────────────────

;; Cienkie wrappery: `tui::run` oczekuje funkcji jako wartości, a kompilator H# zamienia
;; bezargumentowe `modul::init` użyte jako wartość na jego WYWOŁANIE — dlatego przekazujemy
;; lokalne nazwy `init`/`update`/`view`, które delegują do modułów.
fn init() -> any is return ui_state::init() end

fn update(model_in: any, msg: any) -> (any, fn() -> any) is return ui_update::update(model_in, msg) end

fn view(model_in: any) -> string is return ui_view::view(model_in) end

fn main() is
    tui::run(init, update, view)
end
