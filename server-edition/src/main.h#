fn view_disk(m: Model) -> string is
    let d_idx: int = tui::list_selected_index(m.disk_list)
    let mode: int = tui::list_selected_index(m.mode_list)
    let disk: string = current_disk(m)
    let mut out: string = header(m) + "\n\n" + section("Dysk", m.focus == 0) + "\n" + tui::list_view(m.disk_list) + "\n"
    if d_idx >= 0 && d_idx < m.disks.len() && m.disks[d_idx].removable is
        out = out + tui::style_render(error_style(), "Uwaga: to urządzenie jest oznaczone jako wymienne (USB?).") + "\n"
    end

    let others: [model::OtherOs] = system_scan::other_os_on_disk(system_scan::parse_other_os(m.os_raw), disk)
    if others.len() > 0 is
        out = out + tui::colorize("Wykryte systemy na tym dysku:", "yellow") + "\n"
        let mut o: int = 0
        while o < others.len() is
            out = out + "  • " + model::other_os_label(others[o]) + "\n"
            o += 1
        end
    elsif !system_scan::os_prober_available() is
        out = out + tui::colorize("Brak os-prober — nie można wykryć innych systemów.", "8") + "\n"
    end

    out = out + "\n" + section("Partycjonowanie", m.focus == 1) + "\n" + tui::list_view(m.mode_list) + "\n"
    if mode == 0 is
        out = out + tui::style_render(error_style(), "Cała zawartość dysku " + disk + " zostanie trwale usunięta.") + "\n"
    elsif mode == 1 is
        let free: model::FreeSpace = system_scan::detect_free_space(disk)
        out = out + "Wolne miejsce do użycia: " + to_string(free.size_mb) + " MiB (wymagane " +
            to_string(validate::alongside_min_mb()) + " MiB). Istniejące partycje nie są ruszane.\n"
    else is
        out = out + "Na następnym ekranie przypiszesz punkty montowania do istniejących partycji.\n"
    end

    if mode != 2 is
        out = out + "\n" + section("System plików", m.focus == 2) + "\n" + tui::list_view(m.fs_list) + "\n" +
            marker(m.focus == 3) + check(m.swap_on) + " Plik wymiany (spacja)\n"
        if m.swap_on is out = out + field_line("Rozmiar swap (MiB)", m.swap_input, m.focus == 4) + "\n" end
    end
    out = out + marker(m.focus == 5) + check(m.luks_on) + " Zaszyfruj dysk (LUKS2) (spacja)\n"
    if m.luks_on is
        out = out + pw_line("Hasło szyfrowania", m.luks_pw, m.focus == 6, "min. 8 znaków") + "\n" +
            pw_line("Powtórz hasło     ", m.luks_pw2, m.focus == 7, "powtórz") + "\n" +
            tui::colorize("Powstanie niezaszyfrowana partycja /boot (1 GiB).", "8") + "\n"
    end
    return out + error_block(m) + "\n" +
        tui::help_view(["tab", "↑/↓", "spacja", "r", "enter", "esc"],
            ["następne pole", "wybierz", "przełącz", "skanuj systemy", "dalej", "wstecz"])
end

