;; ── Instalator HackerOS — Standard Edition (Silver 0.4) ───────────────
;;
;; Architektura 0.3: interfejs jest napisany w TypeScript + Solid.js
;; (frontend/src → esbuild → frontend/dist/app.js). Cały STAN kreatora żyje
;; po stronie frontendu (sygnały Solida), a ten plik jest cienką,
;; BEZSTANOWĄ warstwą komend: każda komenda dostaje JSON, woła rdzeń
;; (pakiet `main`) i zwraca JSON. Typowany kontrakt: frontend/src/api.ts.
;;
;;  * Instalacja biegnie w TLE (installer_run::start → runner.sh); frontend
;;    odpytuje `poll_install` timerem — okno nigdy nie zamarza.
;;  * Hasła przechodzą przez most tylko w pamięci (start_install) i trafiają
;;    do pliku sekretów 0600, nigdy do planu ani logu.
;;  * Wspólna walidacja (`validate_step`) jest tą samą, której używa TTY.
;;
;; UWAGA: w literałach H# klamry podwajamy; JSON budujemy przez data::*.

;; ── pomocnicze: JSON ─────────────────────────────────────────────────

fn arr(items: [string]) -> string is
    return "[" + str::join(items, ",") + "]"
end

fn ok_obj() -> string is
    return data::set_bool(data::object(), "ok", true)
end

fn err_obj(msg: string) -> string is
    let o: string = data::set_bool(data::object(), "ok", false)
    return data::set_str(o, "error", msg)
end

fn b2(v: bool) -> int is
    if v is return 1 end
    return 0
end

fn lbl(codes: [string], labels: [string]) -> string is
    let mut items: [string] = []
    let mut i: int = 0
    while i < codes.len() is
        let o: string = data::set_str(data::object(), "code", codes[i])
        items.push(data::set_str(o, "label", labels[i]))
        i += 1
    end
    return arr(items)
end

;; ── konfiguracja: JSON ↔ InstallConfig ───────────────────────────────

fn cfg_from(raw: string) -> model::InstallConfig is
    let c: string = data::get_raw(raw, "config")
    let mut cfg: model::InstallConfig = model::default_config("standard")
    cfg.step = steps::step_from_index(data::get_int(c, "step"))
    cfg.locale = data::get_str(c, "locale")
    cfg.keyboard = data::get_str(c, "keyboard")
    cfg.timezone = data::get_str(c, "timezone")
    cfg.online = data::get_bool(c, "online")
    cfg.mirror_id = data::get_str(c, "mirror_id")
    cfg.mirror_url = str::trim(data::get_str(c, "mirror_url"))
    cfg.target_disk = data::get_str(c, "target_disk")
    cfg.partition_mode = data::get_str(c, "partition_mode")
    cfg.filesystem = data::get_str(c, "filesystem")
    cfg.enable_swap = data::get_bool(c, "enable_swap")
    cfg.swap_size_mb = data::get_int(c, "swap_size_mb")
    cfg.luks = data::get_bool(c, "luks")
    cfg.luks_password = data::get_str(c, "luks_password")
    cfg.luks_confirm = data::get_str(c, "luks_confirm")
    cfg.profile = data::get_str(c, "profile")
    cfg.install_hsharp = data::get_bool(c, "install_hsharp")
    cfg.install_bit = data::get_bool(c, "install_bit")
    cfg.hostname = str::trim(data::get_str(c, "hostname"))
    cfg.user.username = str::trim(data::get_str(c, "username"))
    cfg.user.full_name = data::get_str(c, "full_name")
    cfg.user.password = data::get_str(c, "password")
    cfg.user.is_admin = data::get_bool(c, "is_admin")
    cfg.password_confirm = data::get_str(c, "password_confirm")
    cfg.root_password = data::get_str(c, "root_password")
    cfg.root_confirm = data::get_str(c, "root_confirm")
    cfg.uefi = system_scan::detect_uefi()
    cfg.accepted_summary = data::get_bool(c, "accepted_summary")
    cfg.resume_available = data::get_bool(c, "resume_available")
    cfg.resume = data::get_bool(c, "resume")

    let mut specs: [model::PartSpec] = []
    let parts_raw: string = data::get_raw(c, "manual_parts")
    if parts_raw != "" is
        let items: [string] = data::items(parts_raw)
        let mut i: int = 0
        while i < items.len() is
            let mp: string = str::trim(data::get_str(items[i], "mountpoint"))
            if mp != "" is
                specs.push(model::PartSpec {
                    device: data::get_str(items[i], "device"),
                    mountpoint: mp,
                    fs: data::get_str(items[i], "fs"),
                    format: data::get_bool(items[i], "format")
                })
            end
            i += 1
        end
    end
    cfg.manual_parts = specs
    return cfg
end

;; Konfiguracja → JSON (bez haseł) — do wczytania zapisanej konfiguracji.
fn cfg_obj(cfg: model::InstallConfig) -> string is
    let mut o: string = data::object()
    o = data::set_str(o, "locale", cfg.locale)
    o = data::set_str(o, "keyboard", cfg.keyboard)
    o = data::set_str(o, "timezone", cfg.timezone)
    o = data::set_str(o, "mirror_id", cfg.mirror_id)
    o = data::set_str(o, "mirror_url", cfg.mirror_url)
    o = data::set_str(o, "target_disk", cfg.target_disk)
    o = data::set_str(o, "partition_mode", cfg.partition_mode)
    o = data::set_str(o, "filesystem", cfg.filesystem)
    o = data::set_bool(o, "enable_swap", cfg.enable_swap)
    o = data::set_int(o, "swap_size_mb", cfg.swap_size_mb)
    o = data::set_bool(o, "luks", cfg.luks)
    o = data::set_str(o, "profile", cfg.profile)
    o = data::set_bool(o, "install_hsharp", cfg.install_hsharp)
    o = data::set_bool(o, "install_bit", cfg.install_bit)
    o = data::set_str(o, "hostname", cfg.hostname)
    o = data::set_str(o, "username", cfg.user.username)
    o = data::set_str(o, "full_name", cfg.user.full_name)
    o = data::set_bool(o, "is_admin", cfg.user.is_admin)
    let mut parts: [string] = []
    let mut i: int = 0
    while i < cfg.manual_parts.len() is
        let p: model::PartSpec = cfg.manual_parts[i]
        let mut po: string = data::set_str(data::object(), "device", p.device)
        po = data::set_str(po, "mountpoint", p.mountpoint)
        po = data::set_str(po, "fs", p.fs)
        po = data::set_bool(po, "format", p.format)
        parts.push(po)
        i += 1
    end
    return data::set_raw(o, "manual_parts", arr(parts))
end

;; ── obiekty list ─────────────────────────────────────────────────────

fn disk_obj(d: model::Disk) -> string is
    let mut o: string = data::set_str(data::object(), "device", d.device)
    o = data::set_str(o, "model", d.model)
    o = data::set_int(o, "size_gb", d.size_gb)
    o = data::set_bool(o, "removable", d.removable)
    return data::set_str(o, "label", model::disk_label(d))
end

fn part_obj(p: model::PartInfo) -> string is
    let mut o: string = data::set_str(data::object(), "device", p.device)
    o = data::set_int(o, "size_mb", p.size_mb)
    o = data::set_str(o, "fstype", p.fstype)
    o = data::set_str(o, "label", p.label)
    o = data::set_bool(o, "is_esp", p.is_esp)
    return data::set_str(o, "text", model::part_label(p))
end

fn os_obj(x: model::OtherOs) -> string is
    let mut o: string = data::set_str(data::object(), "device", x.device)
    o = data::set_str(o, "name", x.name)
    o = data::set_str(o, "kind", x.kind)
    return data::set_str(o, "text", model::other_os_label(x))
end

fn wifi_obj(n: model::WifiNet) -> string is
    let mut o: string = data::set_str(data::object(), "ssid", n.ssid)
    o = data::set_int(o, "signal", n.signal)
    o = data::set_str(o, "security", n.security)
    o = data::set_bool(o, "in_use", n.in_use)
    return data::set_str(o, "label", model::wifi_label(n))
end

fn profile_obj(p: model::Profile) -> string is
    let mut o: string = data::set_str(data::object(), "id", p.id)
    o = data::set_str(o, "label", p.label)
    o = data::set_str(o, "description", p.description)
    o = data::set_raw(o, "packages", data::str_array(p.packages))
    return data::set_bool(o, "needs_network", profiles::needs_network(p))
end

fn steps_meta() -> string is
    let mut items: [string] = []
    let mut i: int = 0
    while i < steps::step_count() is
        let s: model::Step = steps::step_from_index(i)
        let mut o: string = data::set_int(data::object(), "index", i)
        o = data::set_str(o, "title", steps::step_title(s))
        o = data::set_str(o, "subtitle", steps::step_subtitle(s))
        o = data::set_bool(o, "can_back", steps::can_go_back(s))
        o = data::set_bool(o, "can_next", steps::can_go_next(s))
        items.push(o)
        i += 1
    end
    return arr(items)
end

;; ── komendy: start ───────────────────────────────────────────────────

fn cmd_bootstrap(args: string) -> string is
    let mut o: string = data::object()
    o = data::set_str(o, "core_version", "0.2.0")
    o = data::set_bool(o, "uefi", system_scan::detect_uefi())
    o = data::set_str(o, "default_hostname", system_scan::default_hostname())
    o = data::set_int(o, "ram_mb", system_scan::ram_total_mb())
    o = data::set_int(o, "cpus", system_scan::cpu_count())
    o = data::set_bool(o, "has_resume", config_io::has_resume_config())
    o = data::set_raw(o, "steps", steps_meta())
    o = data::set_raw(o, "locales", lbl(locales::locale_codes(), locales::locale_labels()))
    o = data::set_raw(o, "keyboards", lbl(locales::keyboard_codes(), locales::keyboard_labels()))
    o = data::set_raw(o, "timezones", lbl(locales::timezone_codes(), locales::timezone_labels()))
    o = data::set_bool(o, "gparted", util::has_cmd("gparted"))
    o = data::set_int(o, "alongside_min_mb", validate::alongside_min_mb())
    o = data::set_str(o, "hsharp_version", plan::hsharp_version())
    o = data::set_str(o, "bit_version", plan::bit_version())
    return o
end

;; ── komendy: sieć ────────────────────────────────────────────────────

fn cmd_network_status(args: string) -> string is
    let mut o: string = data::object()
    o = data::set_bool(o, "online", network::is_online())
    o = data::set_bool(o, "wifi_available", network::wifi_available())
    let ms: [model::Mirror] = network::mirrors()
    let mut items: [string] = []
    let mut i: int = 0
    while i < ms.len() is
        let mut m: string = data::set_str(data::object(), "id", ms[i].id)
        m = data::set_str(m, "label", ms[i].label)
        items.push(data::set_str(m, "url", ms[i].url))
        i += 1
    end
    return data::set_raw(o, "mirrors", arr(items))
end

fn cmd_wifi_scan(args: string) -> string is
    let nets: [model::WifiNet] = network::scan_wifi(data::get_bool(args, "rescan"))
    let mut items: [string] = []
    let mut i: int = 0
    while i < nets.len() && i < 20 is
        items.push(wifi_obj(nets[i]))
        i += 1
    end
    return data::set_raw(data::object(), "networks", arr(items))
end

fn cmd_wifi_connect(args: string) -> string is
    let ssid: string = data::get_str(args, "ssid")
    if ssid == "" is return err_obj("Najpierw wybierz sieć z listy.") end
    network::connect_start(ssid, data::get_str(args, "password"))
    return ok_obj()
end

;; done=false dopóki trwa łączenie; potem ok + komunikat.
fn cmd_wifi_poll(args: string) -> string is
    let r: string = network::connect_poll()
    let mut o: string = data::object()
    if r == "" is return data::set_bool(o, "done", false) end
    network::connect_clear()
    o = data::set_bool(o, "done", true)
    o = data::set_bool(o, "ok", r == "ok")
    o = data::set_str(o, "message", if r == "ok" then "Połączono." else r)
    return data::set_bool(o, "online", network::is_online())
end

;; ── komendy: dysk ────────────────────────────────────────────────────

fn cmd_list_disks(args: string) -> string is
    let disks: [model::Disk] = system_scan::detect_disks()
    let mut items: [string] = []
    let mut i: int = 0
    while i < disks.len() is
        items.push(disk_obj(disks[i]))
        i += 1
    end
    return data::set_raw(data::object(), "disks", arr(items))
end

fn cmd_disk_info(args: string) -> string is
    let disk: string = data::get_str(args, "disk")
    let free: model::FreeSpace = system_scan::detect_free_space(disk)
    let parts: [model::PartInfo] = system_scan::detect_partitions(disk)
    let mut items: [string] = []
    let mut i: int = 0
    while i < parts.len() is
        items.push(part_obj(parts[i]))
        i += 1
    end
    let mut o: string = data::set_int(data::object(), "free_mb", free.size_mb)
    o = data::set_int(o, "free_start_mb", free.start_mb)
    o = data::set_int(o, "free_end_mb", free.end_mb)
    o = data::set_str(o, "table", system_scan::disk_table(disk))
    o = data::set_str(o, "esp", system_scan::find_esp(disk))
    return data::set_raw(o, "partitions", arr(items))
end

;; os-prober bywa wolny — osobna komenda, wołana raz przy wejściu w krok.
fn cmd_probe_os(args: string) -> string is
    let disk: string = data::get_str(args, "disk")
    let all: [model::OtherOs] = system_scan::parse_other_os(system_scan::probe_other_os_raw())
    let here: [model::OtherOs] = system_scan::other_os_on_disk(all, disk)
    let mut items: [string] = []
    let mut i: int = 0
    while i < here.len() is
        items.push(os_obj(here[i]))
        i += 1
    end
    let mut o: string = data::set_bool(data::object(), "prober", system_scan::os_prober_available())
    return data::set_raw(o, "systems", arr(items))
end

fn cmd_open_gparted(args: string) -> string is
    if util::has_cmd("gparted") is process::spawn("gparted") end
    return ok_obj()
end

;; ── komendy: profile ─────────────────────────────────────────────────

fn cmd_list_profiles(args: string) -> string is
    let ps: [model::Profile] = profiles::all()
    let mut items: [string] = []
    let mut i: int = 0
    while i < ps.len() is
        items.push(profile_obj(ps[i]))
        i += 1
    end
    return data::set_raw(data::object(), "profiles", arr(items))
end

;; ── komendy: nawigacja i walidacja ───────────────────────────────────

fn cmd_validate_step(args: string) -> string is
    let cfg: model::InstallConfig = cfg_from(args)
    let mut r: validate::ValidationResult = validate::validate_step(cfg)
    if r.ok && cfg.step == model::Step::Disk is
        let free: model::FreeSpace = system_scan::detect_free_space(cfg.target_disk)
        let ae: string = validate::alongside_error(cfg, free.size_mb)
        if ae != "" is r = validate::ValidationResult { ok: false, message: ae } end
    end
    let o: string = data::set_bool(data::object(), "ok", r.ok)
    return data::set_str(o, "message", r.message)
end

;; Następny / poprzedni krok (z pominięciem „Partycji” poza trybem ręcznym).
fn cmd_nav(args: string) -> string is
    let cfg: model::InstallConfig = cfg_from(args)
    let target: model::Step = if data::get_str(args, "dir") == "back" then steps::prev_for(cfg) else steps::next_for(cfg)
    return data::set_int(data::object(), "step", steps::step_index(target))
end

fn cmd_summary(args: string) -> string is
    let cfg: model::InstallConfig = cfg_from(args)
    let o: string = data::set_raw(data::object(), "lines", data::str_array(config_io::summary_lines(cfg)))
    let plan_lines: [string] = installer_run::preview_plan(cfg)
    return data::set_raw(o, "plan", data::str_array(plan_lines))
end

;; ── komendy: instalacja ──────────────────────────────────────────────

fn cmd_probe_install(args: string) -> string is
    let cfg: model::InstallConfig = cfg_from(args)
    return data::set_str(data::object(), "state", installer_run::probe(cfg))
end

fn cmd_start_install(args: string) -> string is
    let cfg: model::InstallConfig = cfg_from(args)
    let resume: bool = data::get_bool(args, "resume")
    config_io::save_resume(cfg)
    let err: string = installer_run::start(cfg, resume)
    if err != "" is return err_obj(err) end
    return ok_obj()
end

fn cmd_poll_install(args: string) -> string is
    let p: model::Progress = installer_run::poll()
    let r: model::InstallResult = installer_run::result()
    let mut items: [string] = []
    let mut i: int = 0
    while i < r.steps.len() is
        let mut s: string = data::set_str(data::object(), "label", r.steps[i].label)
        s = data::set_str(s, "status", r.steps[i].status)
        items.push(data::set_int(s, "code", r.steps[i].code))
        i += 1
    end
    let mut o: string = data::set_str(data::object(), "state", p.state)
    o = data::set_int(o, "step", p.step)
    o = data::set_int(o, "total", p.total)
    o = data::set_str(o, "label", p.label)
    o = data::set_int(o, "percent", p.percent)
    o = data::set_raw(o, "steps", arr(items))
    o = data::set_str(o, "failed_label", r.failed_label)
    o = data::set_int(o, "failed_code", r.failed_code)
    o = data::set_str(o, "error_text", r.error_text)
    o = data::set_int(o, "warnings", installer_run::warning_count(r))
    o = data::set_str(o, "log_path", r.log_path)
    if data::get_bool(args, "with_log") is
        o = data::set_str(o, "log_tail", installer_run::log_tail(40))
    end
    if p.state == "ok" is config_io::clear_resume_config() end
    return o
end

fn cmd_load_resume(args: string) -> string is
    let base: model::InstallConfig = model::default_config("standard")
    let cfg: model::InstallConfig = config_io::load_resume(base)
    return data::set_raw(data::object(), "config", cfg_obj(cfg))
end

fn cmd_reboot(args: string) -> string is
    process::run("reboot || systemctl reboot")
    return ok_obj()
end

;; ── punkt wejścia ────────────────────────────────────────────────────

fn font_path() -> string is return "frontend/fonts/DejaVuSans.ttf" end

fn main() is
    let mut a: app::App = app::new("Instalator HackerOS", 960, 700)
    ;; font opcjonalny: bez pliku .ttf Silver używa domyślnego fontu systemowego
    if fs::exists(font_path()) is a = app::with_font(a, font_path(), 16) end
    a = app::set_min_size(a, 760, 560)

    a = app::load_html(a, "frontend/index.html")
    a = app::load_css(a, "frontend/style.css")

    a = app::command(a, "bootstrap", cmd_bootstrap)
    a = app::command(a, "network_status", cmd_network_status)
    a = app::command(a, "wifi_scan", cmd_wifi_scan)
    a = app::command(a, "wifi_connect", cmd_wifi_connect)
    a = app::command(a, "wifi_poll", cmd_wifi_poll)
    a = app::command(a, "list_disks", cmd_list_disks)
    a = app::command(a, "disk_info", cmd_disk_info)
    a = app::command(a, "probe_os", cmd_probe_os)
    a = app::command(a, "open_gparted", cmd_open_gparted)
    a = app::command(a, "list_profiles", cmd_list_profiles)
    a = app::command(a, "validate_step", cmd_validate_step)
    a = app::command(a, "nav", cmd_nav)
    a = app::command(a, "summary", cmd_summary)
    a = app::command(a, "probe_install", cmd_probe_install)
    a = app::command(a, "start_install", cmd_start_install)
    a = app::command(a, "poll_install", cmd_poll_install)
    a = app::command(a, "load_resume", cmd_load_resume)
    a = app::command(a, "reboot", cmd_reboot)

    ;; zbudowany bundle (esbuild) — patrz frontend/package.json
    a = app::load_js(a, ["frontend/dist/app.js"])
    app::run(a)
end
