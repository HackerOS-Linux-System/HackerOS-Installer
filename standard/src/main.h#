fn bar(percent: int) -> string is
    let on: int = percent * 40 / 100
    let mut out: string = "<div class=\"bar\">"
    let mut i: int = 0
    while i < 40 is
        out = out + "<div class=\"" + (if i < on then "bar-seg on" else "bar-seg") + "\"></div>"
        i += 1
    end
    return out + "</div>"
end

fn render_installing() -> string is
    let p: model::Progress = installer_run::poll()
    let r: model::InstallResult = installer_run::result()
    let mut out: string = "<h2>Trwa instalacja</h2>" + bar(p.percent) +
        "<p>" + to_string(p.percent) + "% — krok " + to_string(p.step + 1) + " z " + to_string(p.total) + "</p>" +
        "<p class=\"muted\">" + html_escape(p.label) + "</p>"
    let mut start: int = r.steps.len() - 6
    if start < 0 is start = 0 end
    let mut i: int = start
    out = out + "<div class=\"col\">"
    while i < r.steps.len() is
        let s: model::InstallStepResult = r.steps[i]
        if s.status != "skip" is
            let cls: string = if s.status == "ok" then "result-line ok" elsif s.status == "warn" then "result-line warn" else "result-line fail"
            out = out + "<div class=\"" + cls + "\"><span>" + html_escape(s.label) + "</span></div>"
        end
        i += 1
    end
    return out + "</div><p class=\"muted\">Nie wyłączaj komputera. Okno można bezpiecznie zamknąć — instalacja działa w tle.</p>"
end

fn last_lines(text: string, n: int) -> string is
    let lines: [string] = str::split(text, "\n")
    let mut start: int = lines.len() - n
    if start < 0 is start = 0 end
    let mut out: [string] = []
    let mut i: int = start
    while i < lines.len() is
        out.push(lines[i])
        i += 1
    end
    return str::join(out, "\n")
end

fn render_done(a: app::App, ok: bool) -> string is
    let r: model::InstallResult = installer_run::result()
    let title: string = if ok then "HackerOS został zainstalowany" else "Instalacja nie powiodła się"
    let mut body: string = "<h2>" + title + "</h2><div class=\"col\">"

    if !ok && r.failed_label != "" is
        body = body + "<p class=\"error\">Błąd w kroku: " + html_escape(r.failed_label) + " (kod wyjścia " + to_string(r.failed_code) + ")</p>"
        if r.error_text != "" is
            let tail: [string] = str::split(last_lines(r.error_text, 8), "\n")
            let mut t: int = 0
            while t < tail.len() is
                body = body + "<p class=\"muted\">" + html_escape(tail[t]) + "</p>"
                t += 1
            end
        end
    end

    let mut i: int = 0
    while i < r.steps.len() is
        let s: model::InstallStepResult = r.steps[i]
        if s.status != "skip" is
            let cls: string = if s.status == "ok" then "result-line ok" elsif s.status == "warn" then "result-line warn" else "result-line fail"
            let prefix: string = if s.status == "ok" then "OK    " elsif s.status == "warn" then "OSTRZEŻENIE  " else "BŁĄD  "
            body = body + "<div class=\"" + cls + "\"><span>" + prefix + html_escape(s.label) + "</span></div>"
        end
        i += 1
    end
    body = body + "</div><p class=\"muted\">Pełny log: " + html_escape(r.log_path) + "</p>"
    if installer_run::warning_count(r) > 0 is
        body = body + "<p class=\"muted\">Kroki oznaczone jako OSTRZEŻENIE były opcjonalne i nie powiodły się (np. brak sieci) — system jest zainstalowany.</p>"
    end
    if ok is
        body = body + "<div class=\"btn primary\" on-click=\"do_reboot\"><span>Uruchom ponownie</span></div>"
    else is
        body = body + "<div class=\"row\"><div class=\"btn primary\" on-click=\"h_retry\"><span>Wznów instalację od miejsca błędu</span></div>" +
            "<div class=\"btn ghost\" on-click=\"do_reboot\"><span>Uruchom ponownie</span></div></div>"
    end
    return body
end

fn render(a: app::App, cfg: model::InstallConfig, error_msg: string) -> string is
    let mut body: string = ""
    match cfg.step is
        model::Step::Welcome    => body = render_welcome(a)
        model::Step::Language   => body = render_language(sync::atomic_load("locale_idx"))
        model::Step::Keyboard   => body = render_keyboard(sync::atomic_load("keyboard_idx"))
        model::Step::Timezone   => body = render_timezone(sync::atomic_load("timezone_idx"))
        model::Step::Network    => body = render_network(a, cfg)
        model::Step::Disk       => body = render_disk(a, cfg)
        model::Step::Partitions => body = render_partitions(a, cfg)
        model::Step::Profile    => body = render_profile(a, cfg)
        model::Step::Account    => body = render_account(a)
        model::Step::Summary    => body = render_summary(a, cfg)
        model::Step::Installing => body = render_installing()
        model::Step::Done       => body = render_done(a, flag("install_ok"))
    end

    let mut err_html: string = ""
    if error_msg != "" is
        err_html = "<p class=\"error\">" + html_escape(error_msg) + "</p>"
    end

    let next_label: string = if cfg.step == model::Step::Summary then "Instaluj" else "Dalej"

    return
        "<div class=\"page\"><div class=\"card\">" +
            step_dots(cfg.step) +
            "<p class=\"muted\">" + steps::step_title(cfg.step) + " — " + steps::step_subtitle(cfg.step) + "</p>" +
            body +
            err_html +
            nav_row(cfg, next_label) +
        "</div></div>"
end

