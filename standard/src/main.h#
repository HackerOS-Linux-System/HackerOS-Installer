;; ── Instalator HackerOS — Standard Edition (Silver 0.4) ───────────────
;;
;; Architektura:
;;  * Handlery on-click tylko ustawiają atomiki (`act` + `act_arg`), tick
;;    (co ~100 ms) je odbiera i zmienia stan. Dzięki temu cała logika leży w
;;    jednym miejscu, a handlery nie potrzebują dostępu do `App`.
;;  * Instalacja biegnie w TLE (installer_run::start → runner.sh); tick tylko
;;    odpytuje `poll()`, więc okno nigdy nie zamarza, a pasek postępu płynie.
;;  * Strona jest przerysowywana TYLKO gdy coś się zmieniło (flaga `dirty`) —
;;    pola tekstowe nie tracą kursora. Wpisane wartości są przechwytywane do
;;    stanu aplikacji (`v_<id>`) przed każdym przerysowaniem, więc nawigacja
;;    wstecz/dalej nie czyści formularzy.
;;  * Pola haseł to prawdziwe <input type="password"> (Silver ≥ 0.3).

;; ── stałe ────────────────────────────────────────────────────────────

fn locale_count() -> int   is return locales::locale_codes().len() end
fn keyboard_count() -> int is return locales::keyboard_codes().len() end
fn timezone_count() -> int is return locales::timezone_codes().len() end

fn max_parts() -> int is return 12 end
fn fs_options() -> [string] is return ["ext4", "btrfs", "xfs", "vfat", "swap"] end
fn root_fs_options() -> [string] is return ["ext4", "btrfs", "xfs"] end
fn mode_ids() -> [string] is return ["auto", "alongside", "manual"] end
fn mode_labels() -> [string] is
    return ["Wymaż cały dysk", "Obok istniejących systemów", "Ręcznie"]
end

fn html_escape(s: string) -> string is
    let mut out: string = s
    out = str::replace_all(out, "&", "&amp;")
    out = str::replace_all(out, "<", "&lt;")
    out = str::replace_all(out, ">", "&gt;")
    out = str::replace_all(out, "\"", "&quot;")
    return out
end

fn mark_dirty() is sync::atomic_store("dirty", 1) end

;; Numer z końca id elementu: "pick_disk_3" → 3.
fn suffix_int(args: string) -> int is
    let id: string = data::get_str(args, "id")
    let parts: [string] = str::split(id, "_")
    return util::to_int_or(parts[parts.len() - 1], 0)
end

fn queue(code: int, arg: int) is
    sync::atomic_store("act_arg", arg)
    sync::atomic_store("act", code)
end

;; ── handlery on-click ────────────────────────────────────────────────

fn go_next(args: string) -> string is sync::atomic_store("want_next", 1) return "{}" end
fn go_prev(args: string) -> string is sync::atomic_store("want_prev", 1) return "{}" end

fn h_cycle_prev(args: string) -> string is queue(1, -1) return "{}" end
fn h_cycle_next(args: string) -> string is queue(1, 1)  return "{}" end
fn h_pick_disk(args: string)  -> string is queue(2, suffix_int(args)) return "{}" end
fn h_mode(args: string)       -> string is queue(3, suffix_int(args)) return "{}" end
fn h_fs(args: string)         -> string is queue(4, suffix_int(args)) return "{}" end
fn h_toggle(args: string)     -> string is queue(5, suffix_int(args)) return "{}" end
fn h_pick_wifi(args: string)  -> string is queue(6, suffix_int(args)) return "{}" end
fn h_wifi_scan(args: string)  -> string is queue(7, 0) return "{}" end
fn h_wifi_connect(args: string) -> string is queue(8, 0) return "{}" end
fn h_net_check(args: string)  -> string is queue(9, 0) return "{}" end
fn h_pick_mirror(args: string) -> string is queue(10, suffix_int(args)) return "{}" end
fn h_pick_profile(args: string) -> string is queue(11, suffix_int(args)) return "{}" end
fn h_os_rescan(args: string)  -> string is queue(12, 0) return "{}" end
fn h_pfs(args: string)        -> string is queue(13, suffix_int(args)) return "{}" end
fn h_pfmt(args: string)       -> string is queue(14, suffix_int(args)) return "{}" end
fn h_gparted(args: string)    -> string is queue(15, 0) return "{}" end
fn h_load_resume(args: string) -> string is queue(16, 0) return "{}" end
fn h_retry(args: string)      -> string is queue(17, 0) return "{}" end

fn do_reboot(args: string) -> string is
    process::run("reboot")
    return "{}"
end

;; Indeksy przełączników (id="tg_<n>").
fn tg_swap() -> int is return 0 end
fn tg_luks() -> int is return 1 end
fn tg_admin() -> int is return 2 end
fn tg_accept() -> int is return 3 end
fn tg_hsharp() -> int is return 4 end
fn tg_bit() -> int is return 5 end
fn tg_plan() -> int is return 6 end
fn tg_resume() -> int is return 7 end

fn tg_name(n: int) -> string is
    let names: [string] = ["swap_on", "luks_on", "admin_on", "accepted", "hsharp_on", "bit_on", "show_plan", "resume_on"]
    return names[n]
end

;; ── stan formularza ──────────────────────────────────────────────────

fn v(a: app::App, id: string) -> string is
    return app::state(a, "v_" + id)
end

fn set_v(a: app::App, id: string, val: string) -> app::App is
    return app::set_state(a, "v_" + id, val)
end

fn capture(a: app::App, id: string) -> app::App is
    return set_v(a, id, app::input_value(a, id))
end

;; Przechwytuje pola tekstowe widoczne na bieżącym kroku.
fn capture_inputs(app_in: app::App, step: model::Step) -> app::App is
    let mut a: app::App = app_in
    match step is
        ;; Pole przechwytujemy tylko wtedy, gdy jest NA EKRANIE — nieobecny węzeł
        ;; zwróciłby "" i skasował wcześniej wpisaną (albo wczytaną) wartość.
        model::Step::Network => is
            if app::state(a, "wifi_ssid") != "" && app::state(a, "wifi_open") != "1" is a = capture(a, "wifi_pw") end
            if network::mirror_ids()[sync::atomic_load("mirror_idx")] == "custom" is a = capture(a, "mirror_url") end
        end
        model::Step::Disk => is
            if flag("swap_on") && sync::atomic_load("mode_idx") != 2 is a = capture(a, "swap_mb") end
            if flag("luks_on") is
                a = capture(a, "luks_pw")
                a = capture(a, "luks_pw2")
            end
        end
        model::Step::Partitions => is
            let mut i: int = 0
            while i < max_parts() is
                a = capture(a, "mp_" + to_string(i))
                i += 1
            end
        end
        model::Step::Account => is
            a = capture(a, "hostname")
            a = capture(a, "username")
            a = capture(a, "fullname")
            a = capture(a, "password")
            a = capture(a, "password2")
            a = capture(a, "rootpw")
            a = capture(a, "rootpw2")
        end
        _ => a = a
    end
    return a
end

fn flag(name: string) -> bool is return sync::atomic_load(name) == 1 end

fn disks_now() -> [model::Disk] is return system_scan::detect_disks() end

fn current_disk() -> string is
    let disks: [model::Disk] = disks_now()
    let idx: int = sync::atomic_load("disk_idx")
    if idx >= 0 && idx < disks.len() is return disks[idx].device end
    return ""
end

fn current_parts(a: app::App) -> [model::PartInfo] is
    let disk: string = current_disk()
    if disk == "" is return [] end
    let all: [model::PartInfo] = system_scan::detect_partitions(disk)
    if all.len() > max_parts() is
        let mut cut: [model::PartInfo] = []
        let mut i: int = 0
        while i < max_parts() is
            cut.push(all[i])
            i += 1
        end
        return cut
    end
    return all
end

;; ── budowanie InstallConfig z bieżącego stanu ────────────────────────

fn build_cfg(a: app::App) -> model::InstallConfig is
    let mut cfg: model::InstallConfig = model::default_config("standard")
    cfg.step = steps::step_from_index(sync::atomic_load("step"))

    cfg.locale   = locales::locale_codes()[sync::atomic_load("locale_idx")]
    cfg.keyboard = locales::keyboard_codes()[sync::atomic_load("keyboard_idx")]
    cfg.timezone = locales::timezone_codes()[sync::atomic_load("timezone_idx")]

    cfg.online = flag("online")
    let mirrors: [model::Mirror] = network::mirrors()
    let m_idx: int = sync::atomic_load("mirror_idx")
    cfg.mirror_id = if m_idx >= 0 && m_idx < mirrors.len() then mirrors[m_idx].id else "default"
    cfg.mirror_url = str::trim(v(a, "mirror_url"))

    cfg.target_disk = current_disk()
    cfg.partition_mode = mode_ids()[sync::atomic_load("mode_idx")]
    cfg.filesystem = root_fs_options()[sync::atomic_load("fs_idx")]
    cfg.enable_swap = flag("swap_on")
    cfg.swap_size_mb = util::to_int_or(v(a, "swap_mb"), 0)
    cfg.luks = flag("luks_on")
    cfg.luks_password = v(a, "luks_pw")
    cfg.luks_confirm = v(a, "luks_pw2")

    if cfg.partition_mode == "manual" is
        let parts: [model::PartInfo] = current_parts(a)
        let mut specs: [model::PartSpec] = []
        let mut i: int = 0
        while i < parts.len() is
            let mp: string = str::trim(v(a, "mp_" + to_string(i)))
            if mp != "" is
                specs.push(model::PartSpec {
                    device: parts[i].device,
                    mountpoint: mp,
                    fs: fs_options()[sync::atomic_load("pfs" + to_string(i))],
                    format: flag("pf" + to_string(i))
                })
            end
            i += 1
        end
        cfg.manual_parts = specs
    end

    let ps: [model::Profile] = profiles::all()
    let p_idx: int = sync::atomic_load("profile_idx")
    cfg.profile = if p_idx >= 0 && p_idx < ps.len() then ps[p_idx].id else "minimal"
    cfg.install_hsharp = flag("hsharp_on")
    cfg.install_bit = flag("bit_on")

    let hostname_in: string = str::trim(v(a, "hostname"))
    cfg.hostname = if hostname_in == "" then "hackeros" else hostname_in
    cfg.user.username  = str::trim(v(a, "username"))
    cfg.user.full_name = v(a, "fullname")
    cfg.user.password  = v(a, "password")
    cfg.user.is_admin  = flag("admin_on")
    cfg.password_confirm = v(a, "password2")
    cfg.root_password  = v(a, "rootpw")
    cfg.root_confirm   = v(a, "rootpw2")

    cfg.uefi = flag("uefi")
    cfg.accepted_summary = flag("accepted")
    cfg.resume_available = flag("resume_available")
    cfg.resume = flag("resume_on")
    return cfg
end

;; Odwrotnie: wczytany config → atomiki i stan formularza (wznawianie).
fn index_of_str(items: [string], x: string) -> int is
    let mut i: int = 0
    while i < items.len() is
        if items[i] == x is return i end
        i += 1
    end
    return -1
end

fn apply_cfg(app_in: app::App, c: model::InstallConfig) -> app::App is
    let mut a: app::App = app_in
    let li: int = index_of_str(locales::locale_codes(), c.locale)
    if li >= 0 is sync::atomic_store("locale_idx", li) end
    let ki: int = index_of_str(locales::keyboard_codes(), c.keyboard)
    if ki >= 0 is sync::atomic_store("keyboard_idx", ki) end
    let ti: int = index_of_str(locales::timezone_codes(), c.timezone)
    if ti >= 0 is sync::atomic_store("timezone_idx", ti) end

    let mi: int = index_of_str(network::mirror_ids(), c.mirror_id)
    if mi >= 0 is sync::atomic_store("mirror_idx", mi) end
    a = set_v(a, "mirror_url", c.mirror_url)

    let disks: [model::Disk] = disks_now()
    let mut di: int = -1
    let mut k: int = 0
    while k < disks.len() is
        if disks[k].device == c.target_disk is di = k end
        k += 1
    end
    sync::atomic_store("disk_idx", di)
    let mdi: int = index_of_str(mode_ids(), c.partition_mode)
    if mdi >= 0 is sync::atomic_store("mode_idx", mdi) end
    let fi: int = index_of_str(root_fs_options(), c.filesystem)
    if fi >= 0 is sync::atomic_store("fs_idx", fi) end
    sync::atomic_store("swap_on", util::b2i(c.enable_swap))
    a = set_v(a, "swap_mb", to_string(c.swap_size_mb))
    sync::atomic_store("luks_on", util::b2i(c.luks))

    let pi: int = index_of_str(profiles::ids(), c.profile)
    if pi >= 0 is sync::atomic_store("profile_idx", pi) end
    sync::atomic_store("hsharp_on", util::b2i(c.install_hsharp))
    sync::atomic_store("bit_on", util::b2i(c.install_bit))

    a = set_v(a, "hostname", c.hostname)
    a = set_v(a, "username", c.user.username)
    a = set_v(a, "fullname", c.user.full_name)
    sync::atomic_store("admin_on", util::b2i(c.user.is_admin))

    ;; przypisania partycji: dopasowanie po nazwie urządzenia
    if c.partition_mode == "manual" is
        let parts: [model::PartInfo] = current_parts(a)
        let mut i: int = 0
        while i < parts.len() is
            let mut j: int = 0
            while j < c.manual_parts.len() is
                if c.manual_parts[j].device == parts[i].device is
                    a = set_v(a, "mp_" + to_string(i), c.manual_parts[j].mountpoint)
                    sync::atomic_store("pf" + to_string(i), util::b2i(c.manual_parts[j].format))
                    let fidx: int = index_of_str(fs_options(), c.manual_parts[j].fs)
                    if fidx >= 0 is sync::atomic_store("pfs" + to_string(i), fidx) end
                end
                j += 1
            end
            i += 1
        end
    end
    return a
end

;; ── akcje (odbierane z kolejki `act`) ────────────────────────────────

fn cycle_index(name: string, count: int, delta: int) is
    let cur: int = sync::atomic_load(name)
    sync::atomic_store(name, ((cur + delta) % count + count) % count)
end

fn rescan_os(app_in: app::App) -> app::App is
    return app::set_state(app_in, "os_raw", system_scan::probe_other_os_raw())
end

fn refresh_net(app_in: app::App) -> app::App is
    sync::atomic_store("online", util::b2i(network::is_online()))
    return app_in
end

fn process_action(app_in: app::App, step: model::Step) -> app::App is
    let mut a: app::App = app_in
    let code: int = sync::atomic_load("act")
    if code == 0 is return a end
    let arg: int = sync::atomic_load("act_arg")
    sync::atomic_store("act", 0)
    mark_dirty()

    if code == 1 is
        if step == model::Step::Language is cycle_index("locale_idx", locale_count(), arg) end
        if step == model::Step::Keyboard is cycle_index("keyboard_idx", keyboard_count(), arg) end
        if step == model::Step::Timezone is cycle_index("timezone_idx", timezone_count(), arg) end
    elsif code == 2 is
        sync::atomic_store("disk_idx", arg)
    elsif code == 3 is
        sync::atomic_store("mode_idx", arg)
        if arg == 2 is sync::atomic_store("parts_inited", 0) end
    elsif code == 4 is
        sync::atomic_store("fs_idx", arg)
    elsif code == 5 is
        let nm: string = tg_name(arg)
        sync::atomic_store(nm, 1 - sync::atomic_load(nm))
    elsif code == 6 is
        let nets: [model::WifiNet] = network::scan_wifi(false)
        if arg >= 0 && arg < nets.len() is
            a = app::set_state(a, "wifi_ssid", nets[arg].ssid)
            a = app::set_state(a, "wifi_open", if nets[arg].security == "" then "1" else "0")
        end
    elsif code == 7 is
        network::scan_wifi(true)
        a = app::set_state(a, "wifi_msg", "Skan zakończony.")
    elsif code == 8 is
        let ssid: string = app::state(a, "wifi_ssid")
        if ssid == "" is
            a = app::set_state(a, "wifi_msg", "Najpierw wybierz sieć z listy.")
        else is
            network::connect_start(ssid, v(a, "wifi_pw"))
            sync::atomic_store("connecting", 1)
            a = app::set_state(a, "wifi_msg", "Łączenie z " + ssid + "…")
        end
    elsif code == 9 is
        a = refresh_net(a)
    elsif code == 10 is
        sync::atomic_store("mirror_idx", arg)
    elsif code == 11 is
        sync::atomic_store("profile_idx", arg)
    elsif code == 12 is
        a = rescan_os(a)
    elsif code == 13 is
        cycle_index("pfs" + to_string(arg), fs_options().len(), 1)
    elsif code == 14 is
        let nm: string = "pf" + to_string(arg)
        sync::atomic_store(nm, 1 - sync::atomic_load(nm))
    elsif code == 15 is
        if util::has_cmd("gparted") is process::spawn("gparted") end
    elsif code == 16 is
        let base: model::InstallConfig = build_cfg(a)
        a = apply_cfg(a, config_io::load_resume(base))
        sync::atomic_store("step", steps::step_index(model::Step::Account))
        sync::atomic_store("enter_pending", 1)
        a = app::set_state(a, "error_msg", "Wczytano zapisaną konfigurację. Wpisz ponownie hasła — nie są nigdzie zapisywane.")
    elsif code == 17 is
        a = begin_install(a, true)
    end
    return a
end

;; ── wejście do kroku (jednorazowe skanowanie) ────────────────────────

fn on_enter(app_in: app::App, step: model::Step) -> app::App is
    let mut a: app::App = app_in
    match step is
        model::Step::Network => is
            a = refresh_net(a)
            a = app::set_state(a, "wifi_msg", "")
            if network::wifi_available() is network::scan_wifi(true) end
        end
        model::Step::Disk => is
            if app::state(a, "os_raw") == "" && app::state(a, "os_done") != "1" is
                a = rescan_os(a)
                a = app::set_state(a, "os_done", "1")
            end
        end
        model::Step::Partitions => is
            ;; domyślne systemy plików wg tego, co już jest na partycjach
            if sync::atomic_load("parts_inited") == 0 is
                let parts: [model::PartInfo] = current_parts(a)
                let mut i: int = 0
                while i < parts.len() is
                    let idx: int = if parts[i].is_esp then 3 elsif parts[i].fstype == "swap" then 4 else 0
                    sync::atomic_store("pfs" + to_string(i), idx)
                    sync::atomic_store("pf" + to_string(i), 0)
                    i += 1
                end
                sync::atomic_store("parts_inited", 1)
            end
        end
        model::Step::Summary => is
            ;; czy da się wznowić poprzednią próbę dla DOKŁADNIE tej konfiguracji?
            let cfg: model::InstallConfig = build_cfg(a)
            let st: string = installer_run::probe(cfg)
            sync::atomic_store("resume_available", util::b2i(st == "resume"))
            sync::atomic_store("resume_on", util::b2i(st == "resume"))
            sync::atomic_store("accepted", 0)
            sync::atomic_store("show_plan", 0)
            if st == "running" is
                a = app::set_state(a, "error_msg", "Instalacja już trwa w tle — dołączam do niej.")
                sync::atomic_store("step", steps::step_index(model::Step::Installing))
            end
        end
        _ => a = a
    end
    return a
end

;; ── instalacja w tle ─────────────────────────────────────────────────

fn begin_install(app_in: app::App, resume: bool) -> app::App is
    let mut a: app::App = app_in
    let cfg: model::InstallConfig = build_cfg(a)
    config_io::save_resume(cfg)
    let err: string = installer_run::start(cfg, resume)
    if err != "" is
        a = app::set_state(a, "error_msg", err)
        return a
    end
    sync::atomic_store("idle_ticks", 0)
    sync::atomic_store("step", steps::step_index(model::Step::Installing))
    a = app::set_state(a, "error_msg", "")
    mark_dirty()
    return a
end

fn poll_install(app_in: app::App) -> app::App is
    let mut a: app::App = app_in
    let p: model::Progress = installer_run::poll()
    let sig: string = p.state + "|" + to_string(p.step) + "|" + p.label
    if sig != app::state(a, "install_sig") is
        a = app::set_state(a, "install_sig", sig)
        mark_dirty()
    end

    if p.state == "idle" is
        sync::atomic_store("idle_ticks", sync::atomic_load("idle_ticks") + 1)
        if sync::atomic_load("idle_ticks") > 150 is
            a = app::set_state(a, "error_msg", "Wykonawca instalacji nie wystartował (brak pliku statusu). Sprawdź /var/log/hackeros-installer.log.")
            sync::atomic_store("step", steps::step_index(model::Step::Done))
            sync::atomic_store("install_ok", 0)
            mark_dirty()
        end
    end

    if p.state == "ok" || p.state == "failed" is
        sync::atomic_store("install_ok", util::b2i(p.state == "ok"))
        if p.state == "ok" is config_io::clear_resume_config() end
        sync::atomic_store("step", steps::step_index(model::Step::Done))
        mark_dirty()
    end
    return a
end

;; ── on_tick ──────────────────────────────────────────────────────────

fn tick(app_in: app::App) -> app::App is
    let mut a: app::App = app_in
    let mut error_msg: string = app::state(a, "error_msg")
    let start_step: int = sync::atomic_load("step")
    let cur: model::Step = steps::step_from_index(start_step)

    a = capture_inputs(a, cur)
    a = process_action(a, cur)

    ;; stan połączenia Wi-Fi (w tle)
    if sync::atomic_load("connecting") == 1 is
        let r: string = network::connect_poll()
        if r != "" is
            sync::atomic_store("connecting", 0)
            network::connect_clear()
            a = refresh_net(a)
            a = app::set_state(a, "wifi_msg", if r == "ok" then "Połączono." else r)
            mark_dirty()
        end
    end

    if cur == model::Step::Installing is
        a = poll_install(a)
    end

    if sync::atomic_load("want_prev") == 1 is
        sync::atomic_store("want_prev", 0)
        let c0: model::InstallConfig = build_cfg(a)
        if steps::can_go_back(c0.step) is
            sync::atomic_store("step", steps::step_index(steps::prev_for(c0)))
            error_msg = ""
            sync::atomic_store("enter_pending", 1)
            mark_dirty()
        end
    end

    if sync::atomic_load("want_next") == 1 is
        sync::atomic_store("want_next", 0)
        let cfg: model::InstallConfig = build_cfg(a)
        let mut v_res: validate::ValidationResult = validate::validate_step(cfg)
        if v_res.ok && cfg.step == model::Step::Disk is
            let free: model::FreeSpace = system_scan::detect_free_space(cfg.target_disk)
            let ae: string = validate::alongside_error(cfg, free.size_mb)
            if ae != "" is v_res = validate::ValidationResult { ok: false, message: ae } end
        end
        if !v_res.ok is
            error_msg = v_res.message
        else is
            error_msg = ""
            if cfg.step == model::Step::Summary is
                a = begin_install(a, cfg.resume)
                error_msg = app::state(a, "error_msg")
            else is
                sync::atomic_store("step", steps::step_index(steps::next_for(cfg)))
                sync::atomic_store("enter_pending", 1)
            end
        end
        mark_dirty()
    end

    ;; wejście do nowego kroku — skanowanie sprzętu/sieci raz, nie co tick
    if sync::atomic_load("enter_pending") == 1 is
        sync::atomic_store("enter_pending", 0)
        a = on_enter(a, steps::step_from_index(sync::atomic_load("step")))
        mark_dirty()
    end

    if error_msg != app::state(a, "error_msg") is
        mark_dirty()
    end
    a = app::set_state(a, "error_msg", error_msg)

    if sync::atomic_load("dirty") == 1 is
        sync::atomic_store("dirty", 0)
        let cur_cfg: model::InstallConfig = build_cfg(a)
        a = app::load_html_str(a, render(a, cur_cfg, error_msg))
    end
    return a
end

