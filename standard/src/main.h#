fn init_state(a0: app::App) -> app::App is
    let mut a: app::App = a0
    sync::atomic_new("step", steps::step_index(model::Step::Welcome))
    sync::atomic_new("want_next", 0)
    sync::atomic_new("want_prev", 0)
    sync::atomic_new("act", 0)
    sync::atomic_new("act_arg", 0)
    sync::atomic_new("dirty", 1)
    sync::atomic_new("enter_pending", 0)

    sync::atomic_new("locale_idx", 0)
    sync::atomic_new("keyboard_idx", 0)
    sync::atomic_new("timezone_idx", 0)

    sync::atomic_new("disk_idx", -1)
    sync::atomic_new("mode_idx", 0)
    sync::atomic_new("fs_idx", 0)
    sync::atomic_new("swap_on", 1)
    sync::atomic_new("luks_on", 0)
    sync::atomic_new("parts_inited", 0)

    sync::atomic_new("online", 0)
    sync::atomic_new("connecting", 0)
    sync::atomic_new("mirror_idx", 0)

    sync::atomic_new("profile_idx", 0)
    sync::atomic_new("hsharp_on", 0)
    sync::atomic_new("bit_on", 0)

    sync::atomic_new("admin_on", 1)
    sync::atomic_new("accepted", 0)
    sync::atomic_new("show_plan", 0)
    sync::atomic_new("resume_available", 0)
    sync::atomic_new("resume_on", 0)

    sync::atomic_new("uefi", util::b2i(system_scan::detect_uefi()))
    sync::atomic_new("install_ok", 0)
    sync::atomic_new("idle_ticks", 0)

    let mut i: int = 0
    while i < max_parts() is
        sync::atomic_new("pf" + to_string(i), 0)
        sync::atomic_new("pfs" + to_string(i), 0)
        i += 1
    end

    a = set_v(a, "hostname", system_scan::default_hostname())
    a = set_v(a, "swap_mb", "2048")
    return a
end

fn main() is
    let mut a: app::App = app::new("Instalator HackerOS", 860, 680)
    a = app::with_font(a, "frontend/fonts/DejaVuSans.ttf", 16)
    a = app::load_css(a, "frontend/style.css")
    a = init_state(a)

    a = app::command(a, "go_next", go_next)
    a = app::command(a, "go_prev", go_prev)
    a = app::command(a, "cycle_next", h_cycle_next)
    a = app::command(a, "cycle_prev", h_cycle_prev)
    a = app::command(a, "h_pick_disk", h_pick_disk)
    a = app::command(a, "h_mode", h_mode)
    a = app::command(a, "h_fs", h_fs)
    a = app::command(a, "h_toggle", h_toggle)
    a = app::command(a, "h_pick_wifi", h_pick_wifi)
    a = app::command(a, "h_wifi_scan", h_wifi_scan)
    a = app::command(a, "h_wifi_connect", h_wifi_connect)
    a = app::command(a, "h_net_check", h_net_check)
    a = app::command(a, "h_pick_mirror", h_pick_mirror)
    a = app::command(a, "h_pick_profile", h_pick_profile)
    a = app::command(a, "h_os_rescan", h_os_rescan)
    a = app::command(a, "h_pfs", h_pfs)
    a = app::command(a, "h_pfmt", h_pfmt)
    a = app::command(a, "h_gparted", h_gparted)
    a = app::command(a, "h_load_resume", h_load_resume)
    a = app::command(a, "h_retry", h_retry)
    a = app::command(a, "do_reboot", do_reboot)

    ;; tick co 100 ms: odbiera kliknięcia, odpytuje instalację w tle
    a = app::set_tick_interval(a, 100)
    a = app::on_tick(a, tick)

    ;; Pierwszy render ręcznie, przed app::run — tak ekran startowy nie jest pusty.
    let first_cfg: model::InstallConfig = build_cfg(a)
    a = app::load_html_str(a, render(a, first_cfg, ""))
    sync::atomic_store("dirty", 0)

    app::run(a)
end
