fn render_disk(a: app::App, cfg: model::InstallConfig) -> string is
    let disks: [model::Disk] = disks_now()
    if disks.len() == 0 is
        return "<h2>Dysk instalacyjny</h2>" +
            "<p class=\"error\">Nie wykryto żadnego dysku. Podłącz nośnik i uruchom instalator ponownie.</p>"
    end
    let sel: int = sync::atomic_load("disk_idx")
    let mut out: string = "<h2>Wybierz dysk instalacyjny</h2><div class=\"col\">"
    let mut i: int = 0
    while i < disks.len() is
        out = out + pick_item("h_pick_disk", "disk", i, i == sel, model::disk_label(disks[i]))
        i += 1
    end
    out = out + "</div>"

    if sel < 0 || sel >= disks.len() is
        return out + "<p class=\"muted\">Wybierz dysk, aby zobaczyć opcje partycjonowania.</p>"
    end
    if disks[sel].removable is
        out = out + "<p class=\"error\">To urządzenie jest oznaczone jako wymienne (USB?) — upewnij się, że to właściwy dysk.</p>"
    end

    ;; wykryte inne systemy na tym dysku
    let others: [model::OtherOs] = system_scan::other_os_on_disk(system_scan::parse_other_os(app::state(a, "os_raw")), cfg.target_disk)
    if others.len() > 0 is
        out = out + "<h2>Wykryte systemy na tym dysku</h2><div class=\"col\">"
        let mut o: int = 0
        while o < others.len() is
            out = out + "<p>• " + html_escape(model::other_os_label(others[o])) + "</p>"
            o += 1
        end
        out = out + "</div>"
    elsif system_scan::os_prober_available() is
        out = out + "<p class=\"muted\">os-prober nie wykrył innych systemów na tym dysku.</p>"
    else is
        out = out + "<p class=\"muted\">Brak os-prober — nie można wykryć innych systemów.</p>"
    end
    out = out + "<div class=\"row\">" + button("h_os_rescan", "Skanuj systemy ponownie") + "</div>"

    out = out + "<h2>Sposób partycjonowania</h2><div class=\"col\">"
    let m_sel: int = sync::atomic_load("mode_idx")
    let mut m: int = 0
    while m < 3 is
        out = out + pick_item("h_mode", "mode", m, m == m_sel, mode_labels()[m])
        m += 1
    end
    out = out + "</div>"

    if m_sel == 0 is
        out = out + "<p class=\"error\">Cała zawartość dysku " + html_escape(cfg.target_disk) + " zostanie trwale usunięta.</p>"
    elsif m_sel == 1 is
        let free: model::FreeSpace = system_scan::detect_free_space(cfg.target_disk)
        out = out + "<p>Instalator użyje największego wolnego obszaru: <b>" + to_string(free.size_mb) + " MiB</b> " +
            "(wymagane " + to_string(validate::alongside_min_mb()) + " MiB). Istniejące partycje nie są ruszane.</p>"
        if free.size_mb < validate::alongside_min_mb() is
            out = out + "<p class=\"error\">Za mało wolnego miejsca — zmniejsz partycję innego systemu (np. w GParted).</p>"
        end
        if util::has_cmd("gparted") is out = out + "<div class=\"row\">" + button("h_gparted", "Otwórz GParted") + "</div>" end
    else is
        out = out + "<p class=\"muted\">Na następnym ekranie przypiszesz punkty montowania do istniejących partycji.</p>"
        if util::has_cmd("gparted") is out = out + "<div class=\"row\">" + button("h_gparted", "Otwórz GParted (utwórz partycje)") + "</div>" end
    end

    if m_sel != 2 is
        out = out + "<h2>System plików</h2><div class=\"row\">"
        let f_sel: int = sync::atomic_load("fs_idx")
        let mut f: int = 0
        while f < 3 is
            out = out + pick_item("h_fs", "fs", f, f == f_sel, root_fs_options()[f])
            f += 1
        end
        out = out + "</div>"
        out = out + toggle_div(tg_swap(), flag("swap_on"), "Plik wymiany (swap)")
        if flag("swap_on") is
            out = out + field(a, "Rozmiar pliku wymiany (MiB)", "swap_mb", "text", "2048")
        end
    end

    out = out + toggle_div(tg_luks(), flag("luks_on"), "Zaszyfruj dysk (LUKS2)")
    if flag("luks_on") is
        out = out + field(a, "Hasło szyfrowania (min. 8 znaków)", "luks_pw", "password", "") +
            field(a, "Powtórz hasło szyfrowania", "luks_pw2", "password", "") +
            "<p class=\"muted\">Zostanie utworzona niezaszyfrowana partycja /boot (1 GiB). Hasło będzie wymagane przy każdym starcie.</p>"
    end
    return out
end

