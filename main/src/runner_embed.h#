pub fn script() -> string is
    let mut s: string = ""
    s = s + "#!/bin/sh\n"
    s = s + "# HackerOS Installer - wykonawca planu instalacji (POSIX sh).\n"
    s = s + "#\n"
    s = s + "# Uzycie:  runner.sh <resume 0|1>\n"
    s = s + "# Srodowisko: HOS_STATE (katalog stanu, domyslnie /run/hackeros-installer),\n"
    s = s + "#             HOS_LOG   (log, domyslnie /var/log/hackeros-installer.log)\n"
    s = s + "#\n"
    s = s + "# Pliki w $HOS_STATE:\n"
    s = s + "#   plan.tsv    flagi<TAB>etykieta<TAB>polecenie   (flagi: c=miekki blad, s=sekret, a=zawsze przy wznawianiu)\n"
    s = s + "#   secrets     (opcjonalnie, 0600) przypisania HOS_*_PW='...' - usuwany po zakonczeniu\n"
    s = s + "#   vars        zmienne zapisywane przez hos_set (przezywaja wznowienie)\n"
    s = s + "#   status      state=running|ok|failed, step, total, label\n"
    s = s + "#   results.tsv indeks<TAB>status(ok|warn|fail|skip)<TAB>kod<TAB>etykieta\n"
    s = s + "#   checkpoint  liczba krokow wykonanych bez bledu;  checkpoint.sha = odcisk planu\n"
    s = s + "#   error.txt   koniec wyjscia nieudanego kroku\n"
    s = s + "#   runner.pid  PID wykonawcy\n"
    s = s + "\n"
    s = s + "D=${{HOS_STATE:-/run/hackeros-installer}}\n"
    s = s + "LOG=${{HOS_LOG:-/var/log/hackeros-installer.log}}\n"
    s = s + "TAB=$(printf '\\t')\n"
    s = s + "\n"
    s = s + "log() {{ printf '%s\\n' \"$*\" >>\"$LOG\" 2>/dev/null; }}\n"
    s = s + "\n"
    s = s + "# ---------- zmienne trwale ----------\n"
    s = s + "hos_set() {{ # KEY VALUE\n"
    s = s + "    printf \"%s='%s'\\n\" \"$1\" \"$(printf '%s' \"$2\" | sed \"s/'/'\\\\\\\\''/g\")\" >>\"$D/vars\"\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# ---------- urzadzenia ----------\n"
    s = s + "hos_part() {{ # DISK N -> /dev/sda1, /dev/nvme0n1p1\n"
    s = s + "    case \"$1\" in\n"
    s = s + "        *[0-9]) printf '%sp%s' \"$1\" \"$2\" ;;\n"
    s = s + "        *) printf '%s%s' \"$1\" \"$2\" ;;\n"
    s = s + "    esac\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_partnum() {{ # /dev/sda3 -> 3, /dev/nvme0n1p2 -> 2\n"
    s = s + "    printf '%s' \"$1\" | grep -o '[0-9]*$'\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_disk_of() {{ # /dev/sda1 -> /dev/sda\n"
    s = s + "    p=$(lsblk -no PKNAME \"$1\" 2>/dev/null | head -n1)\n"
    s = s + "    if [ -n \"$p\" ]; then printf '/dev/%s' \"$p\"; else printf '%s' \"$1\"; fi\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# Odmawia pracy na dysku z nosnikiem live albo na czymkolwiek, co nie jest blokowe.\n"
    s = s + "hos_check_target() {{ # DISK\n"
    s = s + "    [ -b \"$1\" ] || {{ echo \"To nie jest urzadzenie blokowe: $1\"; return 1; }}\n"
    s = s + "    for mp in /run/archiso/bootmnt /run/miso/bootmnt /run/live/medium /cdrom; do\n"
    s = s + "        src=$(findmnt -n -o SOURCE \"$mp\" 2>/dev/null) || continue\n"
    s = s + "        [ -n \"$src\" ] || continue\n"
    s = s + "        if [ \"$(hos_disk_of \"$src\")\" = \"$1\" ]; then\n"
    s = s + "            echo \"Dysk $1 zawiera nosnik live, z ktorego dziala instalator.\"\n"
    s = s + "            return 1\n"
    s = s + "        fi\n"
    s = s + "    done\n"
    s = s + "    return 0\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_parts_of() {{ lsblk -ln -o NAME -p \"$1\" 2>/dev/null | grep -vxF \"$1\" | sort; }}\n"
    s = s + "\n"
    s = s + "# Tworzy partycje i zapisuje jej urzadzenie w zmiennej VAR (roznica list przed/po).\n"
    s = s + "hos_mkpart_record() {{ # DISK VAR parted-mkpart-args...\n"
    s = s + "    d=$1; var=$2; shift 2\n"
    s = s + "    hos_parts_of \"$d\" >\"$D/.before\"\n"
    s = s + "    parted -s \"$d\" mkpart \"$@\" || return 1\n"
    s = s + "    partprobe \"$d\" 2>/dev/null; udevadm settle 2>/dev/null; sleep 1\n"
    s = s + "    hos_parts_of \"$d\" >\"$D/.after\"\n"
    s = s + "    new=$(comm -13 \"$D/.before\" \"$D/.after\" | head -n1)\n"
    s = s + "    [ -n \"$new\" ] || {{ echo \"Nie wykryto nowej partycji na $d\"; return 1; }}\n"
    s = s + "    hos_set \"$var\" \"$new\"\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_mount_idem() {{ # DEV MOUNTPOINT [opcje]\n"
    s = s + "    mkdir -p \"$2\"\n"
    s = s + "    if mountpoint -q \"$2\"; then return 0; fi\n"
    s = s + "    if [ -n \"$3\" ]; then mount -o \"$3\" \"$1\" \"$2\"; else mount \"$1\" \"$2\"; fi\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_mkfs() {{ # FS DEV\n"
    s = s + "    case \"$1\" in\n"
    s = s + "        ext4) mkfs.ext4 -F \"$2\" ;;\n"
    s = s + "        btrfs) mkfs.btrfs -f \"$2\" ;;\n"
    s = s + "        xfs) mkfs.xfs -f \"$2\" ;;\n"
    s = s + "        vfat) mkfs.fat -F32 \"$2\" ;;\n"
    s = s + "        swap) mkswap \"$2\" ;;\n"
    s = s + "        *) echo \"Nieobslugiwany system plikow: $1\"; return 1 ;;\n"
    s = s + "    esac\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# ---------- szyfrowanie ----------\n"
    s = s + "hos_luks_format() {{ # DEV  (haslo: $HOS_LUKS_PW przez stdin)\n"
    s = s + "    printf '%s' \"$HOS_LUKS_PW\" | cryptsetup luksFormat --type luks2 -q --key-file=- \"$1\" || return 1\n"
    s = s + "    printf '%s' \"$HOS_LUKS_PW\" | cryptsetup open --key-file=- \"$1\" cryptroot\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_luks_open() {{ # DEV\n"
    s = s + "    [ -e /dev/mapper/cryptroot ] && return 0\n"
    s = s + "    printf '%s' \"$HOS_LUKS_PW\" | cryptsetup open --key-file=- \"$1\" cryptroot\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# crypttab, hook initramfs i parametry jadra dla GRUB. LUKS_PART = urzadzenie LUKS.\n"
    s = s + "hos_luks_boot() {{ # LUKS_PART\n"
    s = s + "    uuid=$(blkid -s UUID -o value \"$1\") || return 1\n"
    s = s + "    [ -n \"$uuid\" ] || return 1\n"
    s = s + "    printf 'cryptroot UUID=%s none luks\\n' \"$uuid\" >/mnt/etc/crypttab\n"
    s = s + "    if [ -f /mnt/etc/mkinitcpio.conf ]; then\n"
    s = s + "        if grep -q '^HOOKS=.*systemd' /mnt/etc/mkinitcpio.conf; then\n"
    s = s + "            hook=sd-encrypt\n"
    s = s + "            params=\"rd.luks.name=$uuid=cryptroot root=/dev/mapper/cryptroot\"\n"
    s = s + "        else\n"
    s = s + "            hook=encrypt\n"
    s = s + "            params=\"cryptdevice=UUID=$uuid:cryptroot root=/dev/mapper/cryptroot\"\n"
    s = s + "        fi\n"
    s = s + "        if ! grep -q \"^HOOKS=.*$hook\" /mnt/etc/mkinitcpio.conf; then\n"
    s = s + "            sed -i \"s/^\\(HOOKS=.*\\)filesystems/\\1$hook filesystems/\" /mnt/etc/mkinitcpio.conf\n"
    s = s + "        fi\n"
    s = s + "        arch-chroot /mnt mkinitcpio -P || return 1\n"
    s = s + "    else\n"
    s = s + "        mkdir -p /mnt/etc/dracut.conf.d\n"
    s = s + "        printf 'add_dracutmodules+=\" crypt \"\\n' >/mnt/etc/dracut.conf.d/hackeros-luks.conf\n"
    s = s + "        params=\"rd.luks.uuid=$uuid rd.luks.name=$uuid=cryptroot root=/dev/mapper/cryptroot\"\n"
    s = s + "        if command -v dracut >/dev/null 2>&1 || [ -x /mnt/usr/bin/dracut ]; then\n"
    s = s + "            arch-chroot /mnt dracut --force --regenerate-all || return 1\n"
    s = s + "        fi\n"
    s = s + "    fi\n"
    s = s + "    f=/mnt/etc/default/grub\n"
    s = s + "    [ -f \"$f\" ] || {{ echo \"Brak $f\"; return 1; }}\n"
    s = s + "    if grep -q '^GRUB_CMDLINE_LINUX=' \"$f\"; then\n"
    s = s + "        sed -i \"s|^GRUB_CMDLINE_LINUX=\\\"\\(.*\\)\\\"|GRUB_CMDLINE_LINUX=\\\"\\1 $params\\\"|\" \"$f\"\n"
    s = s + "    else\n"
    s = s + "        printf 'GRUB_CMDLINE_LINUX=\"%s\"\\n' \"$params\" >>\"$f\"\n"
    s = s + "    fi\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# ---------- konta ----------\n"
    s = s + "hos_set_pw() {{ # UZYTKOWNIK NAZWA_ZMIENNEJ_Z_HASLEM  (haszowane sha512, przez stdin)\n"
    s = s + "    eval \"pw=\\${{$2}}\"\n"
    s = s + "    h=$(printf '%s' \"$pw\" | openssl passwd -6 -stdin) || return 1\n"
    s = s + "    [ -n \"$h\" ] || return 1\n"
    s = s + "    printf '%s:%s\\n' \"$1\" \"$h\" | arch-chroot /mnt chpasswd -e\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# ---------- serwer lustrzany ----------\n"
    s = s + "hos_mirror() {{ # URL  (bazowy, bez /$repo/os/$arch)\n"
    s = s + "    mkdir -p /mnt/etc/pacman.d\n"
    s = s + "    printf 'Server = %s/$repo/os/$arch\\n' \"$1\" >/mnt/etc/pacman.d/mirrorlist\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "hos_mirror_auto() {{\n"
    s = s + "    command -v reflector >/dev/null 2>&1 || {{ echo \"Brak reflectora\"; return 1; }}\n"
    s = s + "    reflector --latest 20 --sort rate --protocol https --save /mnt/etc/pacman.d/mirrorlist\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "# ---------- narzedzia ----------\n"
    s = s + "hos_fingerprint() {{\n"
    s = s + "    if command -v sha256sum >/dev/null 2>&1; then\n"
    s = s + "        sha256sum \"$D/plan.tsv\" | cut -d' ' -f1\n"
    s = s + "    else\n"
    s = s + "        cksum \"$D/plan.tsv\" | cut -d' ' -f1,2\n"
    s = s + "    fi\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "write_status() {{ # state step total label\n"
    s = s + "    {{\n"
    s = s + "        printf 'state=%s\\n' \"$1\"\n"
    s = s + "        printf 'step=%s\\n' \"$2\"\n"
    s = s + "        printf 'total=%s\\n' \"$3\"\n"
    s = s + "        printf 'label=%s\\n' \"$4\"\n"
    s = s + "    }} >\"$D/status.tmp\" && mv \"$D/status.tmp\" \"$D/status\"\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "cleanup() {{ rm -f \"$D/secrets\" \"$D/runner.pid\"; }}\n"
    s = s + "\n"
    s = s + "main() {{\n"
    s = s + "    resume=${{1:-0}}\n"
    s = s + "    mkdir -p \"$D\" || exit 2\n"
    s = s + "    [ -f \"$D/plan.tsv\" ] || {{ echo \"Brak planu: $D/plan.tsv\" >&2; exit 2; }}\n"
    s = s + "    echo $$ >\"$D/runner.pid\"\n"
    s = s + "    trap cleanup EXIT\n"
    s = s + "\n"
    s = s + "    total=$(grep -c '' \"$D/plan.tsv\")\n"
    s = s + "    fp=$(hos_fingerprint)\n"
    s = s + "    cp=0\n"
    s = s + "    if [ \"$resume\" = 1 ] && [ -f \"$D/checkpoint.sha\" ] && [ \"$(cat \"$D/checkpoint.sha\")\" = \"$fp\" ] \\\n"
    s = s + "        && [ -f \"$D/checkpoint\" ]; then\n"
    s = s + "        cp=$(cat \"$D/checkpoint\")\n"
    s = s + "        case \"$cp\" in ''|*[!0-9]*) cp=0 ;; esac\n"
    s = s + "    fi\n"
    s = s + "    if [ \"$cp\" -gt 0 ]; then\n"
    s = s + "        # ponowna proba kroku, ktory zawiodl - stary wpis o bledzie znika\n"
    s = s + "        grep -v \"${{TAB}}fail${{TAB}}\" \"$D/results.tsv\" >\"$D/results.tmp\" 2>/dev/null; mv \"$D/results.tmp\" \"$D/results.tsv\"\n"
    s = s + "    else\n"
    s = s + "        : >\"$D/results.tsv\"; : >\"$D/vars\"; rm -f \"$D/error.txt\"\n"
    s = s + "        printf '%s' \"$fp\" >\"$D/checkpoint.sha\"; echo 0 >\"$D/checkpoint\"\n"
    s = s + "    fi\n"
    s = s + "\n"
    s = s + "    log \"==================================================\"\n"
    s = s + "    log \"HackerOS Installer - start (wznowienie: $resume, od kroku: $((cp + 1))/$total)\"\n"
    s = s + "    log \"==================================================\"\n"
    s = s + "    write_status running \"$cp\" \"$total\" \"Start\"\n"
    s = s + "\n"
    s = s + "    i=0\n"
    s = s + "    while IFS= read -r line || [ -n \"$line\" ]; do\n"
    s = s + "        flags=${{line%%\"$TAB\"*}}\n"
    s = s + "        rest=${{line#*\"$TAB\"}}\n"
    s = s + "        label=${{rest%%\"$TAB\"*}}\n"
    s = s + "        cmd=${{rest#*\"$TAB\"}}\n"
    s = s + "\n"
    s = s + "        if [ \"$i\" -lt \"$cp\" ]; then\n"
    s = s + "            case \"$flags\" in\n"
    s = s + "                *a*) : ;;\n"
    s = s + "                *) i=$((i + 1)); continue ;;\n"
    s = s + "            esac\n"
    s = s + "        fi\n"
    s = s + "\n"
    s = s + "        write_status running \"$i\" \"$total\" \"$label\"\n"
    s = s + "        case \"$flags\" in\n"
    s = s + "            *s*) log \"$ [polecenie ukryte] - $label\" ;;\n"
    s = s + "            *) log \"$ $cmd\" ;;\n"
    s = s + "        esac\n"
    s = s + "\n"
    s = s + "        (\n"
    s = s + "            [ -f \"$D/vars\" ] && . \"$D/vars\"\n"
    s = s + "            [ -f \"$D/secrets\" ] && . \"$D/secrets\"\n"
    s = s + "            eval \"$cmd\"\n"
    s = s + "        ) >\"$D/step.out\" 2>&1\n"
    s = s + "        rc=$?\n"
    s = s + "\n"
    s = s + "        if [ \"$rc\" -eq 0 ]; then\n"
    s = s + "            log \"  -> OK\"\n"
    s = s + "            if [ \"$i\" -ge \"$cp\" ]; then\n"
    s = s + "                printf '%s\\tok\\t0\\t%s\\n' \"$i\" \"$label\" >>\"$D/results.tsv\"\n"
    s = s + "                echo $((i + 1)) >\"$D/checkpoint\"\n"
    s = s + "            fi\n"
    s = s + "        else\n"
    s = s + "            tail -n 40 \"$D/step.out\" >\"$D/error.txt\"\n"
    s = s + "            case \"$flags\" in *s*) : ;; *) sed 's/^/    /' \"$D/step.out\" >>\"$LOG\" 2>/dev/null ;; esac\n"
    s = s + "            case \"$flags\" in\n"
    s = s + "                *c*)\n"
    s = s + "                    log \"  -> OSTRZEZENIE (kod $rc)\"\n"
    s = s + "                    printf '%s\\twarn\\t%s\\t%s\\n' \"$i\" \"$rc\" \"$label\" >>\"$D/results.tsv\"\n"
    s = s + "                    echo $((i + 1)) >\"$D/checkpoint\"\n"
    s = s + "                    ;;\n"
    s = s + "                *)\n"
    s = s + "                    log \"  -> BLAD (kod $rc)\"\n"
    s = s + "                    printf '%s\\tfail\\t%s\\t%s\\n' \"$i\" \"$rc\" \"$label\" >>\"$D/results.tsv\"\n"
    s = s + "                    write_status failed \"$i\" \"$total\" \"$label\"\n"
    s = s + "                    log \"Instalacja przerwana na kroku: $label\"\n"
    s = s + "                    exit 1\n"
    s = s + "                    ;;\n"
    s = s + "            esac\n"
    s = s + "        fi\n"
    s = s + "        i=$((i + 1))\n"
    s = s + "    done <\"$D/plan.tsv\"\n"
    s = s + "\n"
    s = s + "    write_status ok \"$total\" \"$total\" \"Gotowe\"\n"
    s = s + "    log \"Instalacja zakonczona pomyslnie.\"\n"
    s = s + "    exit 0\n"
    s = s + "}}\n"
    s = s + "\n"
    s = s + "if [ -z \"$HOS_RUNNER_LIB\" ]; then main \"$@\"; fi\n"
    return s
end
