;; Etykieta dla dowolnego kodu z powyższych list — a jeśli kod nie
;; występuje na liście (użytkownik wpisał własny w polu "Inne"), zwraca
;; sam kod, żeby UI zawsze miało co wyświetlić.
pub fn label_for(codes: [string], labels: [string], code: string) -> string is
    let mut i: int = 0
    while i < codes.len() is
        if codes[i] == code is return labels[i] end
        i += 1
    end
    return code
end
