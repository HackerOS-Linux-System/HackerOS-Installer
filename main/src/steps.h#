mod model

;; Kolejność: Welcome → Język → Klawiatura → Strefa → Sieć → Dysk →
;; (Partycje — tylko tryb ręczny) → Profil → Konto → Podsumowanie →
;; Instalacja → Gotowe.

pub fn step_count() -> int is return 12 end

pub fn step_index(step: model::Step) -> int is
    match step is
        model::Step::Welcome    => 0
        model::Step::Language   => 1
        model::Step::Keyboard   => 2
        model::Step::Timezone   => 3
        model::Step::Network    => 4
        model::Step::Disk       => 5
        model::Step::Partitions => 6
        model::Step::Profile    => 7
        model::Step::Account    => 8
        model::Step::Summary    => 9
        model::Step::Installing => 10
        model::Step::Done       => 11
    end
end

pub fn step_from_index(i: int) -> model::Step is
    match i is
        0  => model::Step::Welcome
        1  => model::Step::Language
        2  => model::Step::Keyboard
        3  => model::Step::Timezone
        4  => model::Step::Network
        5  => model::Step::Disk
        6  => model::Step::Partitions
        7  => model::Step::Profile
        8  => model::Step::Account
        9  => model::Step::Summary
        10 => model::Step::Installing
        _  => model::Step::Done
    end
end

pub fn step_title(step: model::Step) -> string is
    match step is
        model::Step::Welcome    => "Witaj"
        model::Step::Language   => "Język i lokalizacja"
        model::Step::Keyboard   => "Układ klawiatury"
        model::Step::Timezone   => "Strefa czasowa"
        model::Step::Network    => "Sieć"
        model::Step::Disk       => "Dysk instalacyjny"
        model::Step::Partitions => "Partycje"
        model::Step::Profile    => "Profil instalacji"
        model::Step::Account    => "Konto użytkownika"
        model::Step::Summary    => "Podsumowanie"
        model::Step::Installing => "Instalacja"
        model::Step::Done       => "Zakończono"
    end
end

pub fn step_subtitle(step: model::Step) -> string is
    match step is
        model::Step::Welcome    => "Kreator instalacji HackerOS"
        model::Step::Language   => "Wybierz język systemu i format regionalny"
        model::Step::Keyboard   => "Wybierz układ klawiatury używany po instalacji"
        model::Step::Timezone   => "Wybierz strefę czasową dla zegara systemowego"
        model::Step::Network    => "Połącz się z Internetem i wybierz serwer pakietów"
        model::Step::Disk       => "Wybierz dysk i sposób partycjonowania"
        model::Step::Partitions => "Przypisz punkty montowania do istniejących partycji"
        model::Step::Profile    => "Wybierz zestaw oprogramowania"
        model::Step::Account    => "Utwórz swoje konto użytkownika"
        model::Step::Summary    => "Sprawdź ustawienia przed rozpoczęciem instalacji"
        model::Step::Installing => "Trwa instalacja — nie wyłączaj komputera"
        model::Step::Done       => "Instalacja zakończona"
    end
end

pub fn can_go_back(step: model::Step) -> bool is
    match step is
        model::Step::Welcome    => false
        model::Step::Installing => false
        model::Step::Done       => false
        _ => true
    end
end

pub fn can_go_next(step: model::Step) -> bool is
    match step is
        model::Step::Installing => false
        model::Step::Done       => false
        _ => true
    end
end

;; Krok „Partycje” istnieje tylko w trybie ręcznym.
pub fn next_for(cfg: model::InstallConfig) -> model::Step is
    let i: int = step_index(cfg.step)
    if i + 1 >= step_count() is return cfg.step end
    let n: model::Step = step_from_index(i + 1)
    if n == model::Step::Partitions && cfg.partition_mode != "manual" is
        return step_from_index(i + 2)
    end
    return n
end

pub fn prev_for(cfg: model::InstallConfig) -> model::Step is
    let i: int = step_index(cfg.step)
    if i <= 0 is return cfg.step end
    let p: model::Step = step_from_index(i - 1)
    if p == model::Step::Partitions && cfg.partition_mode != "manual" is
        return step_from_index(i - 2)
    end
    return p
end
