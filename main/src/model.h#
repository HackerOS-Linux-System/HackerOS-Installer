pub enum Step is
    Welcome
    Language
    Keyboard
    Timezone
    Network
    Disk
    Partitions
    Profile
    Account
    Summary
    Installing
    Done
end

;; ── Sprzęt ───────────────────────────────────────────────────────────
pub struct Disk is
    pub device:    string   ;; "/dev/sda", "/dev/nvme0n1"
    pub model:     string
    pub size_gb:   int
    pub removable: bool
end

pub fn disk_label(d: Disk) -> string is
    let base: string = d.device + "  —  " + to_string(d.size_gb) + " GB"
    if d.model != "" is
        return base + "  (" + d.model + ")"
    end
    return base
end

pub struct PartInfo is
    pub device:  string   ;; "/dev/sda1"
    pub size_mb: int
    pub fstype:  string   ;; "" gdy brak systemu plików
    pub label:   string
    pub is_esp:  bool
end

pub fn part_label(p: PartInfo) -> string is
    let fs: string = if p.fstype == "" then "brak systemu plików" else p.fstype
    let lb: string = if p.label == "" then "" else "  [" + p.label + "]"
    return p.device + "  —  " + to_string(p.size_mb) + " MiB  —  " + fs + lb
end

;; Największy wolny obszar na dysku (parted, jednostki MiB).
pub struct FreeSpace is
    pub start_mb: int
    pub end_mb:   int
    pub size_mb:  int
end

;; Inny system wykryty przez os-prober ("/dev/sda1:Windows 10:Windows:chain").
pub struct OtherOs is
    pub device: string
    pub name:   string
    pub kind:   string
end

pub fn other_os_label(o: OtherOs) -> string is
    return o.name + "  (" + o.device + ")"
end

;; ── Sieć ─────────────────────────────────────────────────────────────
pub struct WifiNet is
    pub ssid:     string
    pub signal:   int
    pub security: string   ;; "" = sieć otwarta
    pub in_use:   bool
end

pub fn wifi_label(n: WifiNet) -> string is
    let sec: string = if n.security == "" then "otwarta" else n.security
    let cur: string = if n.in_use then "  ✓ połączono" else ""
    return n.ssid + "  —  " + to_string(n.signal) + "%  —  " + sec + cur
end

pub struct Mirror is
    pub id:    string
    pub label: string
    pub url:   string
end

;; ── Profile ──────────────────────────────────────────────────────────
pub struct Profile is
    pub id:          string
    pub label:       string
    pub description: string
    pub image:       string
    pub packages:    [string]
end

;; ── Partycje ręczne ──────────────────────────────────────────────────
pub struct PartSpec is
    pub device:     string
    pub mountpoint: string   ;; "/", "/home", "/boot", "/boot/efi", "swap"
    pub fs:         string   ;; ext4 | btrfs | xfs | vfat | swap
    pub format:     bool
end

;; ── Konto ────────────────────────────────────────────────────────────
pub struct UserAccount is
    pub username:  string
    pub full_name: string
    pub password:  string   ;; jawne tylko w pamięci; na dysk trafia haszowane (hos_set_pw)
    pub is_admin:  bool
end

pub fn empty_user() -> UserAccount is
    return UserAccount { username: "", full_name: "", password: "", is_admin: true }
end

;; ── Pełna konfiguracja ───────────────────────────────────────────────
pub struct InstallConfig is
    pub step: Step

    pub locale:   string
    pub keyboard: string
    pub timezone: string

    pub online:     bool
    pub mirror_id:  string
    pub mirror_url: string

    pub target_disk:    string
    pub partition_mode: string      ;; "auto" | "alongside" | "manual"
    pub filesystem:     string      ;; ext4 | btrfs | xfs (root w auto/alongside)
    pub enable_swap:    bool
    pub swap_size_mb:   int
    pub luks:           bool
    pub luks_password:  string
    pub luks_confirm:   string
    pub manual_parts:   [PartSpec]

    pub profile:         string
    pub install_hsharp:  bool
    pub install_bit:     bool

    pub hostname:         string
    pub user:             UserAccount
    pub password_confirm: string
    pub root_password:    string
    pub root_confirm:     string

    pub uefi:    bool
    pub edition: string

    pub accepted_summary: bool
    pub resume_available: bool
    pub resume:           bool
end

pub fn default_config(edition: string) -> InstallConfig is
    return InstallConfig {
        step: Step::Welcome,
        locale: "en_US.UTF-8", keyboard: "us", timezone: "UTC",
        online: false, mirror_id: "default", mirror_url: "",
        target_disk: "", partition_mode: "auto", filesystem: "ext4",
        enable_swap: true, swap_size_mb: 2048,
        luks: false, luks_password: "", luks_confirm: "", manual_parts: [],
        profile: "minimal", install_hsharp: false, install_bit: false,
        hostname: "hackeros", user: empty_user(), password_confirm: "",
        root_password: "", root_confirm: "",
        uefi: false, edition: edition,
        accepted_summary: false, resume_available: false, resume: false
    }
end

;; ── Postęp i wynik instalacji w tle ──────────────────────────────────
pub struct Progress is
    pub state:   string   ;; "idle" | "running" | "ok" | "failed"
    pub step:    int
    pub total:   int
    pub label:   string
    pub percent: int
end

pub struct InstallStepResult is
    pub label:  string
    pub status: string   ;; "ok" | "warn" | "fail" | "skip"
    pub code:   int
end

pub struct InstallResult is
    pub success:      bool
    pub steps:        [InstallStepResult]
    pub failed_label: string
    pub failed_code:  int
    pub error_text:   string
    pub log_path:     string
end
