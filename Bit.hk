[package]
-> name        => hackeros-installer
-> version     => 0.3.0
-> description => Instalator HackerOS: rdzeń (main) + GUI Silver (standard) + TTY tui (server-edition)
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0

[workspace]
-> members => [main, standard, server-edition]
-> mode    => standard

[commands]
-> test-runner
--> run => cd main && h# test src/hos_runner_test.h#
--> description => Testy wykonawcy planu instalacji (H#: tests/runner_test.h#)
-> test-frontend
--> run => cd standard/frontend && npm install --no-audit --no-fund && npm run typecheck && npm test
--> description => Typy TypeScript + test dymny interfejsu Solid (jsdom)
-> embed
--> run => h# run tools/embed.h# frontend .
--> description => Przegeneruj frontend_embed.h# (HTML+CSS+JS wlinkowane statycznie) — generator w H#: tools/embed.h#
